# Database connection string (MySQL via PyMySQL)
# Update 'password' with your local MySQL root password or configured user
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/salesiq_db

# Groq API Configuration
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (Currently supported: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Origin for Frontend
FRONTEND_ORIGIN=http://localhost:5173

# Application Port
PORT=8000
