# Database connection string (MySQL via PyMySQL)
# Example for local MySQL: mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/salesiq_db
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/salesiq_db

# Groq API Configuration
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (Currently supported: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
# Verify active models at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Origin for Frontend
FRONTEND_ORIGIN=http://localhost:5173

# Application Port (used for local or cloud deployment)
PORT=8000
